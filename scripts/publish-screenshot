#!/usr/bin/env bash
#
# Uploads screenshot(s) to a rolling GitHub Release so they render inline in
# a PR description or comment. Release assets live outside the git object
# database, so this never touches repo history or clone size.

set -euo pipefail

RELEASE_TAG="pr-screenshots"

show_help() {
  cat <<'EOF'
Usage:
  ./scripts/publish-screenshot <file> [<file> ...]

Uploads each screenshot to the rolling "pr-screenshots" GitHub Release
(created on first use if missing) and prints a markdown image line per
file, ready to paste into a PR description or comment.
EOF
}

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
  show_help
  exit 0
fi

if ! gh release view "$RELEASE_TAG" >/dev/null 2>&1; then
  gh release create "$RELEASE_TAG" \
    --title "PR screenshot evidence" \
    --notes "Rolling storage for screenshots linked from PR descriptions. Not a versioned release; assets accumulate here, not in git history." \
    --prerelease
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
stamp="$(date +%Y%m%d-%H%M%S)"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

for file in "$@"; do
  if [[ ! -f "$file" ]]; then
    echo "publish-screenshot: no such file: $file" >&2
    exit 1
  fi
  base="$(basename "$file")"
  asset_name="${branch//\//-}-${stamp}-${base}"
  ln -s "$(realpath "$file")" "$tmpdir/$asset_name"
  gh release upload "$RELEASE_TAG" "$tmpdir/$asset_name" >&2
  url="$(gh release view "$RELEASE_TAG" --json assets \
    --jq ".assets[] | select(.name==\"$asset_name\") | .url")"
  echo "![${base}](${url})"
done
